# ================================================================
# Personal Hub — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA faça commit do .env.local com valores reais!
# ================================================================

# ── Banco de dados ───────────────────────────────────────────────
# Opções recomendadas (gratuitas):
#   Supabase: https://supabase.com  (projeto > Settings > Database)
#   Neon:     https://neon.tech
#   Railway:  https://railway.app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/personal_hub?schema=public&pgbouncer=true&connection_limit=10"

# ── Autenticação JWT ─────────────────────────────────────────────
# Gere segredos fortes com: openssl rand -base64 32
JWT_SECRET="SUBSTITUA_POR_STRING_ALEATORIA_MIN_32_CHARS"
JWT_REFRESH_SECRET="SUBSTITUA_POR_STRING_ALEATORIA_DIFERENTE_MIN_32_CHARS"

# ── OpenAI (Assistente IA) ───────────────────────────────────────
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# ── E-mail (Resend) ──────────────────────────────────────────────
# Gratuito até 3.000 e-mails/mês: https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="Personal Hub <noreply@seudominio.com>"

# ── Clima (OpenWeatherMap) ───────────────────────────────────────
# Gratuito até 1.000 calls/dia: https://openweathermap.org/api
OPENWEATHER_API_KEY="sua-chave-aqui"
NEXT_PUBLIC_WEATHER_CITY="São Paulo"
NEXT_PUBLIC_WEATHER_COUNTRY="BR"

# ── Supabase Storage (uploads de arquivos) ───────────────────────
# Obtenha em: Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://XXXXXXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Sentry (monitoramento de erros) ─────────────────────────────
# Gratuito: https://sentry.io (crie um projeto Next.js)
NEXT_PUBLIC_SENTRY_DSN="https://XXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXXX"
SENTRY_DSN="https://XXXXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXXX"
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="sua-org"
SENTRY_PROJECT="personal-hub"

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Personal Hub"

# ── Modo manutenção ──────────────────────────────────────────────
# Defina como "true" para ativar a página de manutenção
MAINTENANCE_MODE="false"

# ── Logs ─────────────────────────────────────────────────────────
# Níveis: trace | debug | info | warn | error | fatal
LOG_LEVEL="debug"

# ── Node.js ──────────────────────────────────────────────────────
NODE_ENV="development"
